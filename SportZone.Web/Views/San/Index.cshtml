@model DanhSachSanVM
@{ ViewData["Title"] = "Danh sách sân"; }
<h1 class="h4 mb-3">Danh sách sân</h1>
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(Model.MaLoai == null ? "btn-success" : "btn-outline-success")" asp-action="Index">Tất cả</a>
    @foreach (var l in Model.LoaiSans)
    {
        <a class="btn btn-sm @(Model.MaLoai == l.MaLoai ? "btn-success" : "btn-outline-success")" asp-action="Index" asp-route-maLoai="@l.MaLoai">@l.TenLoai</a>
    }
</div>
@if (!Model.Sans.Any())
{
    <p class="text-muted">Chưa có sân nào thuộc loại này.</p>
}
<div class="row g-3">
    @foreach (var s in Model.Sans)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <partial name="_TheSan" model="(s, Model.GiaTu.TryGetValue(s.MaLoai, out var g) ? g : (decimal?)null)" />
        </div>
    }
</div>

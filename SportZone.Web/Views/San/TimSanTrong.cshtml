@model TimSanTrongVM
@{ ViewData["Title"] = "Tìm sân trống"; }
<h1 class="h4 mb-3">Tìm sân trống</h1>
<form class="row g-2 mb-4" method="get">
    <div class="col-12 col-md-3">
        <label class="form-label small mb-1" for="maLoai">Môn</label>
        <select class="form-select" id="maLoai" name="maLoai">
            <option value="">Tất cả</option>
            @foreach (var l in Model.LoaiSans)
            {
                <option value="@l.MaLoai" selected="@(Model.MaLoai == l.MaLoai)">@l.TenLoai</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small mb-1" for="ngay">Ngày</label>
        <input class="form-control" type="date" id="ngay" name="ngay" value="@Model.Ngay.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-3 col-md-2">
        <label class="form-label small mb-1" for="bd">Từ</label>
        <input class="form-control" type="time" step="1800" id="bd" name="gioBatDau" value="@Model.GioBatDau.ToString("HH:mm")" />
    </div>
    <div class="col-3 col-md-2">
        <label class="form-label small mb-1" for="kt">Đến</label>
        <input class="form-control" type="time" step="1800" id="kt" name="gioKetThuc" value="@Model.GioKetThuc.ToString("HH:mm")" />
    </div>
    <div class="col-12 col-md-2 d-flex align-items-end">
        <button class="btn btn-success w-100" type="submit">Tìm</button>
    </div>
</form>

@if (Model.Loi != null)
{
    <div class="alert alert-warning">@Model.Loi</div>
}
else if (Model.KetQua != null)
{
    <p class="text-muted">Có <strong>@Model.KetQua.Count</strong> sân trống ngày @Model.Ngay.NgayDep(), @Model.GioBatDau.ToString("HH:mm") – @Model.GioKetThuc.ToString("HH:mm").</p>
    <div class="list-group">
        @foreach (var s in Model.KetQua)
        {
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>@s.TenSan</strong> <span class="text-muted small">· @s.LoaiSan?.TenLoai</span>
                </div>
                <a class="btn btn-sm btn-success" asp-controller="DatSan" asp-action="XacNhan"
                   asp-route-maSan="@s.MaSan" asp-route-ngay="@Model.Ngay.ToString("yyyy-MM-dd")"
                   asp-route-gioBatDau="@Model.GioBatDau.ToString("HH:mm")" asp-route-gioKetThuc="@Model.GioKetThuc.ToString("HH:mm")">Đặt sân này</a>
            </div>
        }
    </div>
}

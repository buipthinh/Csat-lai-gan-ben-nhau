@model ErrorViewModel
@{ ViewData["Title"] = "Có lỗi xảy ra"; }
<h1 class="h4">Có lỗi xảy ra</h1>
<p>Xin lỗi, hệ thống gặp sự cố khi xử lý yêu cầu này. Vui lòng thử lại.</p>
@if (Model.ShowRequestId)
{
    <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
}
<a class="btn btn-success" asp-controller="Home" asp-action="Index">Về trang chủ</a>

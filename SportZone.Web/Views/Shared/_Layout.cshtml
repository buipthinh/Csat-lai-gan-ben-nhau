<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-md navbar-dark sz-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">⚽ SportZone</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="San" asp-action="Index">Danh sách sân</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="San" asp-action="TimSanTrong">Tìm sân trống</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="DatSan" asp-action="LichSu">Lịch sử đặt sân</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity.Name</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="ThongTin">Thông tin cá nhân</a></li>
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DoiMatKhau">Đổi mật khẩu</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                                        <button class="dropdown-item" type="submit">Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                        <li class="nav-item"><a class="btn btn-light btn-sm ms-md-2 mt-1" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<main class="container py-4">
    @if (TempData["ThongBao"] is string tb)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@tb<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div>
    }
    @if (TempData["Loi"] is string loi)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@loi<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div>
    }
    @RenderBody()
</main>
<footer class="border-top py-3 text-muted small">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <span>SportZone · Mở cửa 5:00 – 23:00 hằng ngày</span>
        <span>Hotline 0909 000 111</span>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

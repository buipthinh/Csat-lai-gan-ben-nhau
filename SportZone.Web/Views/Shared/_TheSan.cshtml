@model (San San, decimal? GiaTu)
@{ var s = Model.San; }
<div class="card h-100 sz-card">
    <img src="@WebHelpers.AnhSan(s)" class="card-img-top" alt="" />
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="h6 card-title mb-1">@s.TenSan</h3>
            @if (s.TrangThai == TrangThaiSan.BaoTri)
            {
                <span class="badge text-bg-secondary">Bảo trì</span>
            }
        </div>
        <p class="text-muted small mb-2">@s.LoaiSan?.TenLoai</p>
        @if (Model.GiaTu is decimal g)
        {
            <p class="mb-0 small">Từ <strong>@g.Vnd()</strong>/giờ</p>
        }
    </div>
    <div class="card-footer bg-transparent border-0 pt-0">
        <a class="btn btn-sm btn-success w-100" asp-controller="San" asp-action="ChiTiet" asp-route-id="@s.MaSan">Xem lịch & đặt sân</a>
    </div>
</div>

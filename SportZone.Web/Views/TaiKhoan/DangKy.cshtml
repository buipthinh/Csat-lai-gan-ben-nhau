@model DangKyVM
@{ ViewData["Title"] = "Đăng ký"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h4 mb-3">Đăng ký tài khoản</h1>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label class="form-label" asp-for="HoTen"></label>
                <input class="form-control" asp-for="HoTen" autocomplete="name" />
                <span class="text-danger small" asp-validation-for="HoTen"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="SDT"></label>
                <input class="form-control" asp-for="SDT" inputmode="numeric" autocomplete="tel" />
                <span class="text-danger small" asp-validation-for="SDT"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" autocomplete="email" />
                <span class="text-danger small" asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="MatKhau"></label>
                <input class="form-control" asp-for="MatKhau" autocomplete="new-password" />
                <span class="text-danger small" asp-validation-for="MatKhau"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="NhapLai"></label>
                <input class="form-control" asp-for="NhapLai" autocomplete="new-password" />
                <span class="text-danger small" asp-validation-for="NhapLai"></span>
            </div>
            <button class="btn btn-success w-100" type="submit">Đăng ký</button>
        </form>
        <p class="mt-3 small">Đã có tài khoản? <a asp-action="DangNhap">Đăng nhập</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model DangNhapVM
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h4 mb-3">Đăng nhập</h1>
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label class="form-label" asp-for="TaiKhoan"></label>
                <input class="form-control" asp-for="TaiKhoan" autocomplete="username" />
                <span class="text-danger small" asp-validation-for="TaiKhoan"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="MatKhau"></label>
                <input class="form-control" asp-for="MatKhau" autocomplete="current-password" />
                <span class="text-danger small" asp-validation-for="MatKhau"></span>
            </div>
            <button class="btn btn-success w-100" type="submit">Đăng nhập</button>
        </form>
        <p class="mt-3 small">Chưa có tài khoản? <a asp-action="DangKy">Đăng ký</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
